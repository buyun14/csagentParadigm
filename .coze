[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "nextjs"
version = "0.0.32"
appliedPatches = [ ]

[dev]
build = [ "node", "./scripts/prepare.mjs" ]
run = [ "node", "./scripts/dev.mjs" ]
validate = [ "node", "./scripts/validate.mjs" ]
deps = [ "git" ]

[deploy]
build = [ "node", "./scripts/build.mjs" ]
run = [ "node", "./scripts/start.mjs" ]
deps = [ "git" ]
