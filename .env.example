# ============================================
# LLM 基础配置
# ============================================

# API Key（由 coze-coding-dev-sdk 自动管理，通常无需手动配置）
# LLM_API_KEY=your-api-key-here

# API 地址（默认由 SDK 自动配置）
# LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
# 可选模型: doubao-seed-2-0-pro-260215, doubao-seed-2-0-lite-260215, doubao-seed-2-0-mini-260215
#          kimi-k2-5-260127, glm-5-0-260211, glm-4-7-251222, qwen-3-5-plus-260215
# LLM_MODEL=doubao-seed-1-8-251228

# ============================================
# LLM 模型参数（可选，用于调优响应质量/时延）
# 参考: https://help.aliyun.com/zh/model-studio/qwen-api-via-openai-chat-completions
# 注意: 不同模型支持的参数可能不同，未支持的参数会被忽略
# ============================================

# 采样温度 (0-2)
# - 值越高输出越随机/创意，值越低输出越确定/一致
# - 建议: 0.1-0.3 用于结构化输出（如本项目的 JSON 格式），0.7-0.9 用于创意对话
# - 降低 temperature 可减少格式错误，提高响应稳定性
# LLM_TEMPERATURE=0.7

# 核采样概率 (0-1)
# - 与 temperature 配合使用，控制输出的多样性
# - 值越小输出越确定，值越大输出越多样
# - 通常设置为 0.8-0.95
# LLM_TOP_P=0.9

# 最大生成 token 数
# - 限制输出长度，避免过长响应
# - 本项目 JSON 格式通常需要 200-500 tokens
# - 设置过小可能导致输出被截断
# LLM_MAX_TOKENS=1000

# 存在惩罚 (-2 到 2)
# - 正值鼓励讨论新话题，负值鼓励重复
# - 对于客服场景，建议 0-0.5
# LLM_PRESENCE_PENALTY=0

# 频率惩罚 (-2 到 2)
# - 正值降低重复用词，负值鼓励重复
# - 对于客服场景，建议 0-0.3
# LLM_FREQUENCY_PENALTY=0

# 随机种子
# - 用于复现结果，相同种子 + 相同输入 = 相同输出
# - 调试时可用于复现问题
# LLM_SEED=42

# ============================================
# 调优建议
# ============================================
# 
# 【降低时延】
# 1. 使用更快的模型: doubao-seed-2-0-mini-260215（低时延优化）
# 2. 降低 max_tokens: 限制输出长度
# 3. 降低 temperature: 减少模型"思考"时间
#
# 【提高响应质量】
# 1. 使用更强的模型: doubao-seed-2-0-pro-260215 或 kimi-k2-5-260127
# 2. 降低 temperature: 0.1-0.3 用于结构化输出
# 3. 增加 max_tokens: 确保输出不被截断
#
# 【减少格式错误】
# 1. 降低 temperature: 0.1-0.3
# 2. 使用 top_p: 0.8-0.9
# 3. 使用 seed: 固定随机性便于调试
